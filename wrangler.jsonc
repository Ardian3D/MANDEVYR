{
  "name": "mandevyr-p1",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-30",
  "vars": {
    "MANDEVYR_PUBLIC_ORIGINS": "https://mandevyr.vercel.app,https://www.mandevyr.my.id,https://mandevyr.my.id"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "mandevyr-p1",
    "database_id": "2443f2bc-4e24-4d19-9d2c-bf89f3d7e936"
  }],
  "triggers": { "crons": ["*/15 * * * *"] },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
